# ─────────────────────────────────────────────────────────────
# Roketa Music — configuration
# Copy this file to .env and fill in the values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Discord (required) ───────────────────────────────────────
# Bot token: Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=MTQzNjA0MjkyNTM3MTgxODA1Ng.GGzyXQ.v0de77VydKf6UITtjLnpsKwg4U_JwYr_FB-QZM
# Application ID: Developer Portal → your app → General Information
DISCORD_CLIENT_ID=1436042925371818056
# Optional: a test server ID. `npm run deploy` registers commands there instantly.
# Leave empty to deploy globally.
DEV_GUILD_ID=1437432020719505430

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Human-readable logs (default: on unless NODE_ENV=production)
LOG_PRETTY=

# ── Database ─────────────────────────────────────────────────
DATABASE_DRIVER=sqlite
# Relative paths are resolved from the project root. The file is created automatically.
DATABASE_PATH=data/roketa.db

# ── Playback ─────────────────────────────────────────────────
DEFAULT_VOLUME=80
MAX_VOLUME=200
MAX_QUEUE_SIZE=1000
# Max tracks imported from one YouTube playlist
MAX_PLAYLIST_IMPORT=500
# Reject tracks longer than this (seconds). 0 = no limit
MAX_TRACK_DURATION_SECONDS=0
# How many played tracks /previous can go back through
HISTORY_SIZE=50
# Leave voice this long after the queue finishes
QUEUE_END_TIMEOUT_SECONDS=180
# Pause, then leave this long after everyone leaves the voice channel
EMPTY_CHANNEL_TIMEOUT_SECONDS=120
# Reclaim idle players (not playing) after this long
IDLE_PLAYER_TIMEOUT_SECONDS=600
# Stop playback after this many failed tracks in a row
MAX_CONSECUTIVE_FAILURES=5
# How often the Now Playing message refreshes its progress bar (0 = never)
NOW_PLAYING_UPDATE_SECONDS=30

# ── Playlists ────────────────────────────────────────────────
MAX_PLAYLISTS_PER_OWNER=25
MAX_PLAYLIST_TRACKS=500

# ── Spam protection ──────────────────────────────────────────
# Each user may run COMMAND_RATE_LIMIT commands per COMMAND_RATE_WINDOW_SECONDS
COMMAND_RATE_LIMIT=5
COMMAND_RATE_WINDOW_SECONDS=10
BUTTON_COOLDOWN_MS=1000

# ── YouTube extraction (yt-dlp) ──────────────────────────────
# Leave empty to let the bot manage its own up-to-date binary in ./bin (recommended).
YTDLP_PATH=
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_INTERVAL_HOURS=24
# Optional Netscape-format cookies file: enables age-restricted videos and helps
# with "Sign in to confirm you're not a bot". Use a throwaway account.
YTDLP_COOKIES=
YTDLP_MAX_CONCURRENCY=3
YTDLP_TIMEOUT_SECONDS=45
# Extra raw yt-dlp arguments, space separated (advanced)
YTDLP_EXTRA_ARGS=

# ── FFmpeg ───────────────────────────────────────────────────
# Path or command name of the ffmpeg executable
FFMPEG_PATH=ffmpeg
