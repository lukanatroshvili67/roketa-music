{
  "name": "roketa-music",
  "version": "1.0.0",
  "description": "Production-ready Discord music bot: YouTube playback, per-guild queues, persistent playlists.",
  "type": "module",
  "main": "src/index.js",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js",
    "deploy": "node scripts/deploy-commands.js",
    "deploy:global": "node scripts/deploy-commands.js --global",
    "setup": "node scripts/setup-ytdlp.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "test:unit": "node --test \"tests/unit.*.test.js\"",
    "check": "node scripts/check-commands.js"
  },
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "better-sqlite3": "^13.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  }
}
